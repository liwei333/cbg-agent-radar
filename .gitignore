# CBG Agent Radar - Git Ignore Rules
# 禁止提交任何敏感信息

# 环境变量和密钥
.env
.env.*
*.key
*.pem

# 认证和会话
cookies*
token*
auth*
credentials*
session*
adb_keys*

# 网易藏宝阁相关
*cbg_cookie*
*cbg_token*
*netease*
*163_com*

# 个人账号信息
*phone*
*qq*
*wechat*
*id_card*

# GitHub Token
*gho_*
*github_token*

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器临时文件
*.swp
*.swo
*~
.vscode/
.idea/

# 日志中的敏感数据（仅排除可能包含 Cookie/Token 的日志）
mobile/logs/private/
pc/logs/private/
